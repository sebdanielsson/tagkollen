// Copy this file to Config/Secrets.xcconfig (git-ignored) and fill in your key,
// or run Scripts/bootstrap.sh which generates it from .env.local.
// Register a free key at https://data.trafikverket.se
TRV_API_KEY =
// Your Apple Developer team ID (a free Personal Team works for installing on your own devices).
DEVELOPMENT_TEAM =
// Optional: bundle identifier prefix for builds under your own Apple team.
APP_BUNDLE_ID = se.tagkollen.app
